<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Фоновая очередь загрузок с уведомлением о прогрессе. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Обновление из GitHub Releases: скачанный APK отдаётся системному установщику. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Блокировка приложения отпечатком или лицом (Настройки → Приватность). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Ключи сайтов хранятся в Android Keystore; системный бэкап их не уносит. -->
    <application
        android:name=".DudeApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.DudeBooru">

        <activity
            android:name=".ui.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <!-- Файл темы .booru-theme, открытый из Telegram или файлового менеджера. -->
            <intent-filter android:label="@string/themes_open_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/x-dudebooru-theme" />
            </intent-filter>
        </activity>

        <!-- Иконки на выбор: каждая — alias, включён ровно один (см. ui/face/AppIcons.kt). -->
        <activity-alias
            android:name=".icon.Dudi"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_dudi"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_dudi"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icon.Monet"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_monet"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_monet"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icon.Night"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_night"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_night"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icon.Sakura"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_sakura"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_sakura"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icon.Sleepy"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_sleepy"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_sleepy"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icon.Retro"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_retro"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_retro"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icon.Ocean"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_ocean"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_ocean"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icon.Cyber"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_cyber"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_cyber"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icon.Neon"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_neon"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_neon"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icon.Tag"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_tag"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_tag"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icon.Minimal"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_minimal"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_minimal"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icon.Neutral"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_neutral"
            android:label="@string/icon_neutral_label"
            android:roundIcon="@mipmap/ic_neutral"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- Картинки для буфера обмена и «поделиться». -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
